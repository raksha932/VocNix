# ==========================================================
# VOCNIX SAAS PLATFORM CONFIGURATION
# ==========================================================

# APPLICATION
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# LIVEKIT CONFIGURATION
# Server-side only credentials for minting tokens and room management
# For LiveKit Cloud: wss://<your-project>.livekit.cloud
# For Local LiveKit: ws://127.0.0.1:7880
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Client-facing LiveKit WebSocket URL (publicly reachable)
NEXT_PUBLIC_LIVEKIT_URL=ws://127.0.0.1:7880

# SUPABASE / DATABASE CONFIGURATION
# Connect to your Supabase PostgreSQL database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AUTHENTICATION & SECURITY
SESSION_SECRET=super-secure-random-secret-at-least-32-chars
