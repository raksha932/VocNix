# ==========================================================
# VOCNIX SAAS PLATFORM CONFIGURATION
# ==========================================================

# APPLICATION
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# REAL-TIME AUDIO ENGINE CONFIGURATION
# Server-side credentials for generating tokens and audio room routing
LIVEKIT_URL=your-audio-server-url
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# Client-facing WebSocket URL
NEXT_PUBLIC_LIVEKIT_URL=your-audio-server-url

# SUPABASE / DATABASE CONFIGURATION
# Connect to your Supabase PostgreSQL database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AUTHENTICATION & SECURITY
SESSION_SECRET=super-secure-random-secret-at-least-32-chars

# GOOGLE OAUTH 2.0 CREDENTIALS
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AUTHORIZED SUPER ADMIN EMAILS (comma-separated)
SUPER_ADMIN_EMAILS=your-email@gmail.com,admin@vocnix.com

# RESEND EMAIL SERVICE
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM="VocNix <noreply@vocnix.site>"

